# Where the API is. Leave this out to use the defaults: the same site for the web
# build, and https://www.preplitai.com for the installed app.
#
# For local work against the API on this computer, use your computer's address on
# the network (a phone cannot reach "localhost"):
# EXPO_PUBLIC_API_URL=http://192.168.0.10:5000
#
# No secret belongs in this file or anywhere in the app: anything starting with
# EXPO_PUBLIC_ is readable by everyone who has the app.
EXPO_PUBLIC_API_URL=
